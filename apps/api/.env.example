# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Matches docker-compose.yml (local only)
DATABASE_URL=postgres://wtrdrop:wtrdrop_local@localhost:5432/wtrdrop
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=
# Comma-separated list of allowed browser origins (admin portal)
CORS_ORIGINS=http://localhost:5173
# Set to the number of proxies in front of the API in production (for correct client IPs)
TRUST_PROXY=0
# Optional: phone number of the first owner account created by `pnpm db:seed`
SEED_OWNER_PHONE=
